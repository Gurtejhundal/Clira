# Export these in your shell. Clira does not automatically load .env files.
APP_DISPLAY_NAME=Clira
CLIRA_MODE=demo
# demo has synthetic fixtures and never uses Google credentials. live requires OAuth.
CLIRA_DATA_DIR=.clira
CLIRA_IMPORT_DIR=.clira/imports
CLIRA_ENABLE_WRITES=0
CLIRA_MODEL=offline
# To enable paid Gemini calls yourself: set model=gemini and allow_model_calls=1.
CLIRA_ALLOW_MODEL_CALLS=0
CLIRA_MODEL_ID=gemini-2.5-flash
CLIRA_MAX_MODEL_CALLS_DAY=50
# GEMINI_API_KEY= (set privately in your environment)
# CLIRA_GOOGLE_CLIENT_FILE=/absolute/path/outside/repo/client.json
